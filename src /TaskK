import java.util.Scanner;

public class TaskK {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int k = scanner.nextInt();

        // Проверяем возможность набрать шарики
        if (k % 3 == 0 || k % 5 == 0 || k >= 8) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }
    }
}
