import java.util.Scanner;

public class TaskN {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Считываем два числа
        int a = scanner.nextInt();
        int b = scanner.nextInt();

        // Выводим наибольшее из них
        System.out.println(Math.max(a, b));
    }
}
